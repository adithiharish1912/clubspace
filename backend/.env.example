# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Frontend URL(s), comma separated. Used for CORS and for links in emails.
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/clubspace

# ---------- Auth ----------
# Use a long random string in production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# true = users must verify their email before they can log in
REQUIRE_EMAIL_VERIFICATION=false

# ---------- First Super Admin (created by `npm run seed`) ----------
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@clubspace.app
SUPERADMIN_PASSWORD=ChangeMe@123

# ---------- Cloudinary (profile photos, event banners) ----------
# Leave blank in development: files are then stored in backend/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Razorpay ----------
# Leave blank to run payments in DEMO mode (simulated checkout, never in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email (SMTP) ----------
# Leave blank in development: emails are printed to the console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ClubSpace <no-reply@clubspace.app>"

# ---------- WhatsApp (Meta WhatsApp Cloud API) ----------
# Leave blank to disable (messages are logged to the console)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# ---------- Scheduler ----------
# Daily job that expires memberships and sends reminders (cron syntax, server timezone)
REMINDER_CRON=0 9 * * *
TZ=Asia/Kolkata
